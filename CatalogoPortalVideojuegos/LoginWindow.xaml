<Window x:Class="CatalogoPortalVideojuegos.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Portal de Videojuegos" Height="460" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F121C">
    <Grid Margin="30">
        <Border Background="#141829" BorderBrush="#252E4D" BorderThickness="1"
                CornerRadius="14" Padding="24">
            <StackPanel>
                <TextBlock Text="INICIAR SESIÓN" Foreground="#00D2FF" FontSize="22"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Usuario" Foreground="#B0B8D1" Margin="0,0,0,4"/>
                <TextBox x:Name="txtUsuario" Height="32" Background="#0F121C" Foreground="White"
                         BorderBrush="#252E4D" CaretBrush="#00D2FF" VerticalContentAlignment="Center"
                         Padding="6,0"/>

                <TextBlock Text="Contraseña" Foreground="#B0B8D1" Margin="0,14,0,4"/>
                <PasswordBox x:Name="txtPassword" Height="32" Background="#0F121C" Foreground="White"
                             BorderBrush="#252E4D" CaretBrush="#00D2FF" VerticalContentAlignment="Center"
                             Padding="6,0" PasswordChar="●"/>

                <TextBlock x:Name="lblMensaje" Margin="0,14,0,0" TextWrapping="Wrap"
                           MinHeight="40" HorizontalAlignment="Center" TextAlignment="Center"/>

                <Button x:Name="btnLogin" Content="Iniciar Sesión" Height="36" Margin="0,8,0,8"
                        Background="#00D2FF" Foreground="#0F121C" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" IsDefault="True" Click="btnLogin_Click"/>
                <Button x:Name="btnSalir" Content="Salir" Height="36"
                        Background="Transparent" Foreground="#B0B8D1" BorderBrush="#252E4D"
                        Cursor="Hand" Click="btnSalir_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>