<Window x:Class="CatalogoPortalVideojuegos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portal de Videojuegos - DAM" Height="680" Width="1020"
        WindowStartupLocation="CenterScreen" Background="#0F121C">

    <Window.Resources>
        <!-- Estilo Pestañas Superiores tipo Steam -->
        <Style x:Key="SteamNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9AA4BF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" CornerRadius="8" Padding="14,7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#1E2338"/>
                                <Setter Property="Foreground" Value="#00D2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Menú Lateral tipo Biblioteca Steam -->
        <Style x:Key="SteamSidebarButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C2CCE6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="sideBorder" CornerRadius="12" Background="#161B2E" BorderBrush="#252D4A" BorderThickness="1.2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sideBorder" Property="Background" Value="#252D4A"/>
                                <Setter TargetName="sideBorder" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sideBorder" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón JUGAR -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#00B4D8"/>
            <Setter Property="Foreground" Value="#0A0E1A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pBorder" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#90E0EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera Superior: Barra tipo Steam -->
        <Border Grid.Row="0" CornerRadius="16" Background="#141829" BorderBrush="#252E4D" BorderThickness="1" Padding="14,10" Margin="0,0,0,18">
            <Grid>
                <!-- Menú Superior Centrado -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="TIENDA" Style="{StaticResource SteamNavButton}"/>
                    <Button Content="COMUNIDAD" Style="{StaticResource SteamNavButton}"/>
                    <Button Content="SOPORTE" Style="{StaticResource SteamNavButton}"/>
                </StackPanel>

                <!-- Avatar & Perfil + Cerrar Sesión -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="14" Padding="12,5" Background="#1B2138" BorderBrush="#323C63" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#00FFA3" Margin="0,0,8,0"/>
                            <Button Content="mi perfil" FontStyle="Italic" FontWeight="Bold" FontSize="13" Foreground="#E2E8F0"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnCerrarSesion" Content="Cerrar Sesión" Click="btnCerrarSesion_Click"
                            Margin="10,0,0,0" Cursor="Hand" Foreground="#FF6B6B" FontWeight="SemiBold" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="logoutBorder" CornerRadius="14" Padding="12,6"
                                        Background="Transparent" BorderBrush="#FF6B6B" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="logoutBorder" Property="Background" Value="#3A1E26"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Zona Principal: Menú Lateral + Catálogo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú Lateral Izquierdo -->
            <Border Grid.Column="0" CornerRadius="22" BorderBrush="#252E4D" BorderThickness="1" Background="#141829" Margin="0,0,18,10" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="B I B L I O T E C A" FontWeight="Bold" FontSize="11" Foreground="#556285" Margin="6,0,0,10"/>
                    <Button Content="Destacados" Style="{StaticResource SteamSidebarButton}"/>
                    <Button Content="Mis juegos" Style="{StaticResource SteamSidebarButton}"/>
                    <Button Content="Configuración" Style="{StaticResource SteamSidebarButton}"/>
                </StackPanel>
            </Border>

            <!-- Contenedor Principal --> 
            <Border Grid.Column="1" CornerRadius="22" BorderBrush="#252E4D" BorderThickness="1" Background="#141829" Margin="0,0,10,10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <GroupBox Header="Catálogo de Juegos" BorderThickness="0" Foreground="#00D2FF" FontWeight="Bold" FontSize="17">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0">

                            <!-- TARJETA 1: SILKSONG -->
                            <Border Width="200" Height="330" CornerRadius="16" BorderBrush="#2A355A" BorderThickness="1.5" Margin="12,0" Background="#1A2035" Cursor="Hand" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.4" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="240"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="pack://application:,,,/Assets/rocket_league.png" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#111524" Padding="12,8">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="SILKSONG" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Instalado" FontSize="11" Foreground="#A78BFA" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Content="JUGAR" Style="{StaticResource PlayButton}" HorizontalAlignment="Right" Width="68"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- TARJETA 2: VALORANT -->
                            <Border Width="200" Height="330" CornerRadius="16" BorderBrush="#2A355A" BorderThickness="1.5" Margin="12,0" Background="#1A2035" Cursor="Hand" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.4" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="240"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="pack://application:,,,/Assets/valorant.png" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#111524" Padding="12,8">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="VALORANT" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                                <TextBlock Text="En línea" FontSize="11" Foreground="#00D2FF" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Content="JUGAR" Style="{StaticResource PlayButton}" HorizontalAlignment="Right" Width="68"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- TARJETA 3: ROCKET LEAGUE -->
                            <Border Width="200" Height="330" CornerRadius="16" BorderBrush="#2A355A" BorderThickness="1.5" Margin="12,0" Background="#1A2035" Cursor="Hand" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.4" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="240"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="pack://application:,,,/Assets/silksong.png" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#111524" Padding="12,8">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ROCKET LEAGUE" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Listo para jugar" FontSize="11" Foreground="#00FFA3" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Content="JUGAR" Style="{StaticResource PlayButton}" HorizontalAlignment="Right" Width="68"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Border>
        </Grid>
    </Grid>
</Window>